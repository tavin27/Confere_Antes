# URL base da API como o navegador a enxerga. O padrão "/api" funciona com o
# proxy do Vite (desenvolvimento) e com o nginx do Dockerfile (produção).
VITE_API_BASE_URL=/api

# Somente desenvolvimento: para onde o Vite encaminha /api (o Spring Boot local).
DEV_API_TARGET=http://localhost:8080

# Apenas para demonstração local; só é ativado pelo Vite em desenvolvimento.
VITE_DEMO_MODE=false
